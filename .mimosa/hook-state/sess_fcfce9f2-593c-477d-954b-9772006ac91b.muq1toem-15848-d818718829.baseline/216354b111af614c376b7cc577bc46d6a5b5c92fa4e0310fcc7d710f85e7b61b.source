'use strict';
'require baseclass';
'require ui';

/*
 * Glint theme menu renderer
 * Derived from luci-theme-bootstrap menu-bootstrap.js (Apache-2.0,
 * (c) 2022 Jo-Philipp Wich); sidebar DOM and icon set are original (MIT).
 *
 * Renders the LuCI menu tree as a fixed left sidebar with expandable
 * sections (one level of sub items, deeper levels fall back to the
 * page tab strip, same as the bootstrap theme).
 */

const ICONS = {
	status: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 12 7 12 10 5 14 19 17 12 21 12"/></svg>',
	network: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a13.5 13.5 0 0 1 3.6 9 13.5 13.5 0 0 1-3.6 9 13.5 13.5 0 0 1-3.6-9A13.5 13.5 0 0 1 12 3z"/></svg>',
	system: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.6M12 18.6v2.6M2.8 12h2.6M18.6 12h2.6M5.5 5.5l1.8 1.8M16.7 16.7l1.8 1.8M18.5 5.5l-1.8 1.8M7.3 16.7l-1.8 1.8"/></svg>',
	services: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/></svg>',
	vpn: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 2.7v5.5c0 4.3-2.9 7.4-7 9-4.1-1.6-7-4.7-7-9V5.7z"/><polyline points="9 12.2 11.2 14.4 15.3 10"/></svg>',
	nas: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>',
	docker: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 13.5h17c0 3.6-2.6 6.5-6.5 6.5H10c-3.9 0-6.5-2.9-6.5-6.5z"/><path d="M6 10.5h3v3H6zM10 10.5h3v3h-3zM14 10.5h3v3h-3zM10 7h3v3h-3z"/></svg>',
	store: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.2 11a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>',
	logout: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><polyline points="10 8 6 12 10 16"/><line x1="6" y1="12" x2="15" y2="12"/></svg>',
	default: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.2"/></svg>'
};

const QUICK_ICONS = {
	home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5 12 4.5l8 7"/><path d="M6.5 10.5V19a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-8.5"/></svg>',
	package: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/></svg>',
	upgrade: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V4"/><path d="M7.5 8.5 12 4l4.5 4.5"/><path d="M4.5 15v4a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-4"/></svg>',
	terminal: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l4 4-4 4"/><path d="M12 17h7"/></svg>',
	reboot: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5V11"/><path d="M7 6.2a7 7 0 1 0 10 0"/></svg>',
	logout: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><polyline points="10 8 6 12 10 16"/><line x1="6" y1="12" x2="15" y2="12"/></svg>'
};

const KEYWORDS = [
	[/^(status|statistic)/, 'status'],
	[/^network/, 'network'],
	[/^system/, 'system'],
	[/^services/, 'services'],
	[/^vpn/, 'vpn'],
	[/^(nas|diskman|usb|samba)/, 'nas'],
	[/^docker/, 'docker'],
	[/^(store|quickstart)/, 'store']
];

return baseclass.extend({
	__init__() {
		ui.menu.load().then((tree) => this.render(tree));

		const root = document.querySelector('.gl-root');
		const burger = document.getElementById('gl-burger');
		const shade = document.getElementById('gl-shade');

		if (burger && root)
			burger.addEventListener('click', () => root.classList.toggle('gl-sidebar-open'));

		if (shade && root)
			shade.addEventListener('click', () => root.classList.remove('gl-sidebar-open'));
	},

	render(tree) {
		const admin = (tree.children ?? {})['admin'] ?? tree;

		this.renderSidebar(admin);
		this.quickActions(tree);

		let node = tree;
		let url = '';

		if (L.env.dispatchpath.length >= 3) {
			for (let i = 0; i < 3 && node; i++) {
				node = node.children[L.env.dispatchpath[i]];
				url = url + (url ? '/' : '') + L.env.dispatchpath[i];
			}

			if (node)
				this.renderTabMenu(node, url, 0);
		}
	},

	findMenuNode(node, name, trail) {
		const children = node.children ?? {};

		for (const key in children) {
			const path = trail ? trail + '/' + key : key;

			if (key === name)
				return path;

			const hit = this.findMenuNode(children[key], name, path);

			if (hit)
				return hit;
		}

		return null;
	},

	/* GL-style quick action buttons in the topbar; entries whose menu
	 * node does not exist on this build are silently skipped */
	quickActions(tree) {
		const host = document.getElementById('gl-quick');

		if (!host)
			return;

		const has = (path) => {
			let node = tree;

			for (let i = 0; i < path.length && node; i++)
				node = node.children?.[path[i]];

			return !!node;
		};

		const ttyd = this.findMenuNode(tree, 'ttyd', '');
		const icon = (name) => QUICK_ICONS[name] ?? '';

		const groups = [
			[
				[has(['admin', 'status', 'overview']), 'home', _('Overview'), L.url('admin/status/overview')],
				[has(['admin', 'system', 'opkg']), 'package', _('Software'), L.url('admin/system/opkg')],
				[has(['admin', 'system', 'flash']), 'upgrade', _('Backup / Flash Firmware'), L.url('admin/system/flash')],
				[!!ttyd, 'terminal', _('Terminal'), ttyd ? L.url(ttyd) : '#']
			],
			[
				[has(['admin', 'system', 'reboot']), 'reboot', _('Reboot'), L.url('admin/system/reboot')],
				[true, 'logout', _('Log Out'), L.url('admin/logout')]
			]
		];

		let first = true;

		groups.forEach((group) => {
			let shown = false;

			group.forEach((e) => {
				if (!e[0])
					return;

				host.appendChild(E('a', {
					'class': 'gl-quick-btn',
					'href': e[3],
					'title': e[2],
					'aria-label': e[2]
				}, [ E('span', { 'class': 'gl-nav-icon' }, [ icon(e[1]) ]) ]));

				shown = true;
			});

			if (shown && !first)
				host.insertBefore(E('span', { 'class': 'gl-quick-sep' }), host.children[host.children.length - group.length]);

			if (shown)
				first = false;
		});
	},

	iconFor(name) {
		for (const [re, icon] of KEYWORDS)
			if (re.test(name))
				return ICONS[icon];

		return ICONS[name] ?? ICONS.default;
	},

	renderSidebar(node) {
		const nav = document.getElementById('gl-menu');
		const ul = E('ul', { 'class': 'gl-nav-list' });
		const children = ui.menu.getChildren(node ?? {});

		children.forEach((child) => {
			if (child.name === 'logout')
				return;

			const sub = ui.menu.getChildren(child);
			const subUrl = 'admin/' + child.name;
			const isActive = L.env.dispatchpath[1] === child.name;
			const li = E('li', {
				'class': 'gl-nav-sec' +
					(isActive ? ' active' : '') +
					(sub.length ? ' has-sub' : '')
			});

			const link = E('a', {
				'class': 'gl-nav-item' + (isActive ? ' active' : ''),
				'href': sub.length ? '#' : L.url(subUrl)
			}, [
				E('span', { 'class': 'gl-nav-icon', 'aria-hidden': 'true', 'data-icon': child.name }),
				E('span', { 'class': 'gl-nav-label' }, [ _(child.title) ])
			]);

			li.appendChild(link);

			if (sub.length) {
				link.addEventListener('click', (ev) => {
					ev.preventDefault();
					li.classList.toggle('open');
				});

				const subUl = E('ul', { 'class': 'gl-nav-sub' });

				sub.forEach((page) => {
					const pageActive = isActive && L.env.dispatchpath[2] === page.name;

					subUl.appendChild(E('li', {
						'class': pageActive ? 'active' : ''
					}, [
						E('a', {
							'href': L.url(subUrl, page.name),
							'class': 'gl-nav-subitem'
						}, [ _(page.title) ])
					]));
				});

				li.appendChild(subUl);

				if (isActive)
					li.classList.add('open');
			}

			ul.appendChild(li);
		});

		nav.appendChild(ul);

		document.querySelectorAll('.gl-nav-icon[data-icon]').forEach((el) => {
			el.innerHTML = this.iconFor(el.getAttribute('data-icon'));
		});

		const logoutIcon = document.querySelector('.gl-icon-logout');

		if (logoutIcon)
			logoutIcon.innerHTML = ICONS.logout;
	},

	renderTabMenu(tree, url, level) {
		const container = document.querySelector('#tabmenu');

		if (!container)
			return;

		const ul = E('ul', { 'class': 'tabs' });
		const children = ui.menu.getChildren(tree ?? {});
		let activeNode = null;

		children.forEach(child => {
			const isActive = (L.env.dispatchpath[3 + (level || 0)] == child.name);
			const activeClass = isActive ? ' active' : '';
			const className = 'tabmenu-item-%s %s'.format(child.name, activeClass);

			ul.appendChild(E('li', { 'class': className }, [
				E('a', { 'href': L.url(url, child.name) }, [ _(child.title) ])]));

			if (isActive)
				activeNode = child;
		});

		if (ul.children.length == 0)
			return;

		container.appendChild(ul);
		container.style.display = '';

		if (activeNode)
			this.renderTabMenu(activeNode, url + '/' + activeNode.name, (level || 0) + 1);

		return ul;
	}
});
