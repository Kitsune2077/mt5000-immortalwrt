'use strict';
'require form';
'require view';

/*
 * Glint theme personalization settings (original code, MIT).
 * Edits /etc/config/glint which is read by the theme templates.
 * UI strings are written in Chinese directly (no po catalog for this
 * standalone package; firmware defaults to zh-cn).
 */

return view.extend({
	render() {
		const m = new form.Map('glint', _('Glint 主题'),
			_('自定义 LuCI 界面外观。保存并应用后，刷新浏览器页面即可看到效果。'));

		const s = m.section(form.NamedSection, 'main', 'main', _('登录页与外观'));
		s.addremove = false;

		const bg = s.option(form.ListValue, 'login_background', _('登录页背景'));
		bg.value('', _('渐变背景(默认)'));
		bg.value('bing', _('Bing 每日壁纸'));
		bg.default = '';
		bg.rmempty = false;

		const o = s.option(form.Value, 'login_wallpaper', _('自定义壁纸 URL'),
			_('可选。填写图片地址时优先于上方背景模式；留空使用上方设置。'));
		o.rmempty = true;
		o.placeholder = 'https://…';

		const ac = s.option(form.ListValue, 'accent', _('主题强调色'));
		ac.value('cyan', _('青色(默认)'));
		ac.value('indigo', _('靛蓝'));
		ac.value('violet', _('紫色'));
		ac.value('green', _('绿色'));
		ac.value('rose', _('玫红'));
		ac.default = 'cyan';
		ac.rmempty = false;

		return m.render();
	}
});
