# Target: GL.iNet MT5000 (Brume 3) / MediaTek MT7987A filogic
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y

# Rootfs size (8GB eMMC, leave headroom for extra packages)
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# Default LAN IP 10.0.0.1 (official base-files mechanism, also covers failsafe/preinit)
CONFIG_IMAGEOPT=y
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="10.0.0.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="10.0.0.255"

# Kernel prerequisites for dae/dade eBPF (CO-RE) transparent proxy
# BTF needs full debug info (REDUCED must be off)
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_XDP_SOCKETS=y

# Runtime deps baked into firmware
# (self-built kernel kmods are NOT available from any online repo, so all
#  kmods required by daede/dae must be built into the image; the dae/daed
#  userland binaries are installed later via kenzok8/openwrt-daede script)
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
# honk (doona) UDP NFQUEUE staging (queue 320); harmless otherwise
CONFIG_PACKAGE_kmod-nft-queue=y

# --- USB networking on the USB-A port ---
# host stack (ssusb/tphy are enabled in the DTS; drivers must be installed
# or the port stays dead)
CONFIG_PACKAGE_kmod-usb3=y
# wired USB LAN adapters (RTL8152/8153, AX88179/178A, ASIX, CDC-Ether, LAN78xx)
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y
# 4G/5G modem adapter boards (mPCIe/M.2 -> USB): QMI / MBIM / NCM + serial
# ports (kmod-usb-wdm is pulled in as a dependency of qmi/mbim)
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
# phone USB tethering: Android (RNDIS legacy / NCM new), iPhone (ipheth)
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y

# --- multi-WAN management (wired + 4G/5G stick + phone tethering) ---
# mwan3 is opt-in now: the workflow input `enable_mwan3` (default off) adds
# CONFIG_PACKAGE_mwan3/luci-app-mwan3 and emits the first-boot fix-up script
# `99-mwan3-ipv4`. Reason: mwan3's stock config carries `default_rule_v6`
# pointing at the `balanced` policy, which has no IPv6 member in a plain
# PPPoE/DHCP-WAN setup, so mwan3 marks every IPv6 packet "unreachable"
# (ip -6 rule fwmark 0x3e00/0x3f00 unreachable) and IPv6 breaks for both the
# router itself and all downstream clients (address yes, internet no).
# (usb-modeswitch no longer exists in any OpenWrt feed; modern sticks
# enumerate directly as RNDIS/ECM/QMI/MBIM)

# LuCI simplified Chinese UI (default language set by files/etc/uci-defaults)
CONFIG_LUCI_LANG_zh_Hans=y

# Status page: CPU model / freq / temperature (ImmortalWrt specific)
CONFIG_PACKAGE_autocore=y

# Web upload/run installer (mandatory; wukongdaily, feed added by the workflow)
CONFIG_PACKAGE_luci-app-run=y

# iStore app store (feed added by the workflow)
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_luci-app-store=y
