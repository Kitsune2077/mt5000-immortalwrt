From: Dimitri Souza <dimitri.souza@gmail.com>
Date: Sun, 18 Oct 2026 21:37:16 -0300
Subject: [PATCH] net: dsa: rtl8366ub: fix VLAN offload and NAPI cleanup (25.12, original-form)

Reject PPE offload for VLAN-aware RTL8366UB bridges and clean up QDMA
notifiers if dummy NAPI device allocation fails.

Functional content is upstream dmsza/openwrt 8fbeeb6 (2026-10-19). The
795-11 changes are carried verbatim; the 795-12 changes are folded into
the ORIGINAL hunk form from 0001 instead of upstream's companion context
rewrite (8c68cc4 targets dmsza's v25.12.6-based tree and has never been
validated against our pinned v25.12.2 baseline - see the master-profile
CI failure with its 6.18 sibling b669f86d for why that rewrite is risky
here).

Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>
Assisted-by: GitHub Copilot
Adapted-by: Kitsune <km2077@foxmail.com>
Signed-off-by: Dimitri Souza <dimitri.souza@gmail.com>
---
diff --git a/target/linux/generic/pending-6.12/795-11-net-dsa-rtl8366ub-8021q-ppe-offload.patch b/target/linux/generic/pending-6.12/795-11-net-dsa-rtl8366ub-8021q-ppe-offload.patch
index d8afc7e1097e33..ef0decc718dd88 100644
--- a/target/linux/generic/pending-6.12/795-11-net-dsa-rtl8366ub-8021q-ppe-offload.patch
+++ b/target/linux/generic/pending-6.12/795-11-net-dsa-rtl8366ub-8021q-ppe-offload.patch
@@ -96,10 +96,11 @@ diff --git a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c b/drivers/net/ether
 index df53e16..36944d2 100644
 --- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
 +++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
-@@ -10,6 +10,7 @@
+@@ -10,6 +10,8 @@
  #include <net/flow_offload.h>
  #include <net/pkt_cls.h>
  #include <net/dsa.h>
++#include <linux/if_bridge.h>
 +#include <linux/dsa/8021q.h>
  #include "mtk_eth_soc.h"
  #include "mtk_wed.h"
@@ -113,7 +114,7 @@ index df53e16..36944d2 100644
  {
  #if IS_ENABLED(CONFIG_NET_DSA)
  	struct dsa_port *dp;
-@@ -176,8 +177,23 @@
+@@ -176,8 +177,31 @@
  	if (IS_ERR(dp))
  		return -ENODEV;
  
@@ -125,11 +126,19 @@ index df53e16..36944d2 100644
 +		if (push_vid) {
 +			struct net_device *br = dsa_port_bridge_dev_get(dp);
 +
-+			if (br)
++			if (br) {
++				/* The tagger leaves VLAN-aware bridge egress
++				 * untagged. The PPE cannot replace the required
++				 * egress VLAN with this management VID.
++				 */
++				if (br_vlan_enabled(br))
++					return -EOPNOTSUPP;
++
 +				*push_vid = dsa_tag_8021q_bridge_vid(
 +					dsa_port_bridge_num_get(dp));
-+			else
++			} else {
 +				*push_vid = dsa_tag_8021q_standalone_vid(dp);
++			}
 +		}
 +		break;
 +	default:
@@ -147,16 +156,18 @@ index df53e16..36944d2 100644
  
  	if (mtk_flow_get_wdma_info(dev, dest_mac, &info) == 0) {
  		mtk_foe_entry_set_wdma(eth, foe, info.wdma_idx, info.queue,
-@@ -219,7 +237,7 @@
+@@ -219,7 +237,9 @@
  		goto out;
  	}
  
 -	dsa_port = mtk_flow_get_dsa_port(&dev);
 +	dsa_port = mtk_flow_get_dsa_port(&dev, &push_vid);
++	if (dsa_port == -EOPNOTSUPP)
++		return dsa_port;
  
  	if (dev == eth->netdev[0])
  		pse_port = PSE_GDM1_PORT;
-@@ -231,7 +249,13 @@
+@@ -231,7 +251,13 @@
  		return -EOPNOTSUPP;
  
  	if (dsa_port >= 0) {
diff --git a/target/linux/generic/pending-6.12/795-12-net-mediatek-init-dummy-napi-before-netdev-registration.patch b/target/linux/generic/pending-6.12/795-12-net-mediatek-init-dummy-napi-before-netdev-registration.patch
index 707e4a0..f95ec35 100644
--- a/target/linux/generic/pending-6.12/795-12-net-mediatek-init-dummy-napi-before-netdev-registration.patch
+++ b/target/linux/generic/pending-6.12/795-12-net-mediatek-init-dummy-napi-before-netdev-registration.patch
@@ -29,7 +29,7 @@ index 0c13e2a72b..68edd82895 100644
 +	if (!eth->dummy_dev) {
 +		err = -ENOMEM;
 +		dev_err(eth->dev, "failed to allocated dummy device\n");
-+		goto err_deinit_ppe;
++		goto err_unreg_netdev;
 +	}
 +	eth->dummy_dev->threaded = 1;
 +	strcpy(eth->dummy_dev->name, "mtk_eth");
@@ -39,7 +39,7 @@ index 0c13e2a72b..68edd82895 100644
  	for (i = 0; i < MTK_MAX_DEVS; i++) {
  		if (!eth->netdev[i])
  			continue;
-@@ -5725,35 +5740,35 @@ static int mtk_probe(struct platform_device *pdev)
+@@ -5725,35 +5740,37 @@ static int mtk_probe(struct platform_device *pdev)
  		err = register_netdev(eth->netdev[i]);
  		if (err) {
  			dev_err(eth->dev, "error bringing up device\n");
@@ -85,10 +85,12 @@ index 0c13e2a72b..68edd82895 100644
 +		mac = netdev_priv(eth->netdev[i]);
 +		unregister_netdevice_notifier(&mac->device_notifier);
 +	}
-+	netif_napi_del(&eth->tx_napi);
-+	netif_napi_del(&eth->rx_napi);
-+	free_netdev(eth->dummy_dev);
-+	eth->dummy_dev = NULL;
++	if (eth->dummy_dev) {
++		netif_napi_del(&eth->tx_napi);
++		netif_napi_del(&eth->rx_napi);
++		free_netdev(eth->dummy_dev);
++		eth->dummy_dev = NULL;
++	}
  err_deinit_ppe:
  	mtk_ppe_deinit(eth);
  	mtk_mdio_cleanup(eth);
